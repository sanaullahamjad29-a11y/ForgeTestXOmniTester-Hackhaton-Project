APP_ENV=development
DATABASE_URL=sqlite:///./testforge.db
# Added Cloudflare tunnel and wildcard preview support for CORS:
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.trycloudflare.com,https://attendance-recreational-chips-edward.trycloudflare.com
ARTIFACT_DIR=./artifacts

# Vultr Serverless Inference (OpenAI-compatible endpoint)
VULTR_INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017

# Execution Mode: "local" (Playwright + isolated subprocess) or "remote" (isolated Vultr sandbox worker)
RUNNER_MODE=local
SANDBOX_WORKER_URL=
SANDBOX_WORKER_TOKEN=
MAX_RUN_SECONDS=90
CODE_SANDBOX_TIMEOUT_SECONDS=6